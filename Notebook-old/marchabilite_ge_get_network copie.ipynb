   "outputs": [],
   "source": [
    "import itertools\n",
    "\n",
    "# Flatten all values (including lists) and get unique highway types\n",
    "highway_values = edges_gdf['highway'].dropna().tolist()\n",
    "flattened = list(itertools.chain.from_iterable(\n",
    "\tv if isinstance(v, list) else [v] for v in highway_values\n",
    "))\n",
    "unique_highways = set(flattened)\n",
    "unique_highways"
   ]
